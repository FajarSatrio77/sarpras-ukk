%% Flowchart Alur Kerja Web UKK-SARPRAS
%% Dokumen ini menggambarkan alur kerja utama aplikasi manajemen Sarana dan Prasarana

flowchart TB
    subgraph ENTRY["🌐 MASUK APLIKASI"]
        A([Pengunjung]) --> B{Sudah Login?}
        B -->|Tidak| C[/Login atau Register/]
        B -->|Ya| D{Role?}
        C --> E[Login / Register]
        E --> F{User Pengguna/Guru?}
        F -->|Ya| G{Aktivasi?}
        G -->|Belum| H[/Aktivasi Akun/]
        G -->|Sudah| I[/Daftar Sarpras - Pinjam/]
        H --> I
        F -->|Tidak| J[/Dashboard Admin-Petugas/]
        E --> J
        D -->|Pengguna / Guru| I
        D -->|Admin / Petugas| J
    end

    subgraph AUTH["🔐 AUTENTIKASI"]
        direction TB
        L1[Form Login - NISN & Password] --> L2{Valid?}
        L2 -->|Tidak| L1
        L2 -->|Ya| L3{Aktivasi?}
        L3 -->|Belum| L4[Tampilkan pesan aktivasi]
        L3 -->|Sudah| L5[Redirect sesuai role]
        R1[Form Register] --> R2[Simpan User - is_activated: false]
        R2 --> R3[Redirect ke Aktivasi]
        R3 --> A1[Form Aktivasi - Kode]
        A1 --> A2{Aktivasi OK?}
        A2 -->|Ya| A3[is_activated: true]
        A2 -->|Tidak| A1
    end

    subgraph PEMINJAMAN["📦 ALUR PEMINJAMAN"]
        direction TB
        P0[/Daftar Sarpras Tersedia/] --> P1[Pilih Barang]
        P1 --> P2[Form Ajukan: jumlah, tgl, tujuan, lokasi]
        P2 --> P3[Validasi: stok, double booking, durasi max 7 hari siswa]
        P3 --> P4[Simpan - status: menunggu]
        P4 --> P5[Admin/Petugas: Daftar Peminjaman]
        P5 --> P6{Approve / Reject?}
        P6 -->|Reject| P7[status: ditolak + alasan]
        P6 -->|Approve| P8[status: disetujui]
        P8 --> P9[/Handover: Pilih Unit + Upload Foto Kondisi/]
        P9 --> P10[Simpan unit dipinjam, kurangi stok]
        P10 --> P11[status: dipinjam]
        P11 --> P12[/Siswa bawa barang/]
    end

    subgraph PENGEMBALIAN["↩️ ALUR PENGEMBALIAN"]
        direction TB
        K0[/Scan Kode / Input Kode Peminjaman/] --> K1{Kode valid & status dipinjam?}
        K1 -->|Tidak| K0
        K1 -->|Ya| K2[Form Pengembalian: tgl, kondisi per unit]
        K2 --> K3[Kondisi: baik / rusak_ringan / rusak_berat / hilang]
        K3 --> K4[Simpan Pengembalian]
        K4 --> K5[Update status peminjaman: dikembalikan]
        K5 --> K6[Update stok & kondisi unit]
        K6 --> K7{Ada unit hilang?}
        K7 -->|Ya| K8[/Barang Hilang: Ditemukan / Ganti Rugi/]
        K7 -->|Tidak| K9[Selesai]
        K8 --> K9
    end

    subgraph PENGADUAN["📋 ALUR PENGADUAN"]
        direction TB
        AD1[Pengguna/Guru: Buat Pengaduan] --> AD2[Pilih sarpras pernah dipinjam, judul, lokasi, deskripsi]
        AD2 --> AD3[Simpan - status: menunggu]
        AD3 --> AD4[Admin/Petugas: Update status]
        AD4 --> AD5{Status}
        AD5 -->|diproses| AD6[Tanggapi + Catatan]
        AD5 -->|selesai| AD7[Pengaduan selesai]
        AD5 -->|ditutup| AD7
        AD6 --> AD5
    end

    subgraph ADMIN["⚙️ ADMIN & PETUGAS"]
        direction TB
        M1[Kategori SARPRAS] --> M1a[CRUD Kategori]
        M2[Ruang] --> M2a[CRUD Ruang]
        M3[SARPRAS] --> M3a[CRUD Barang + Unit]
        M3a --> M3b[Trash / Restore]
        M4[User - Admin only] --> M4a[CRUD User, Import, Assign Role]
        M4a --> M4b[Aktivasi User]
        M5[Laporan] --> M5a[Kerusakan, Asset Health]
        M5 --> M5b[Damage Analytics, Asset Lifecycle]
        M6[Maintenance] --> M6a[CRUD Maintenance Record]
        M7[Barang Hilang] --> M7a[Resolve: Ditemukan / Ganti Rugi]
        M8[Activity Log] --> M8a[Lihat / Export]
    end

    subgraph LAINNYA["📄 AKSES UMUM"]
        direction LR
        V1[Profile] --> V2[Lihat / Edit Profile]
        V1 --> V3[Ganti Password]
        T1[Detail Peminjaman] --> T2[Cetak Surat Peminjaman]
        T3[Riwayat Peminjaman] --> T1
    end

    J --> P5
    J --> K0
    J --> AD4
    J --> M1
    I --> P0
    P12 --> K0

    style ENTRY fill:#e1f5fe
    style AUTH fill:#f3e5f5
    style PEMINJAMAN fill:#e8f5e9
    style PENGEMBALIAN fill:#fff3e0
    style PENGADUAN fill:#fce4ec
    style ADMIN fill:#eceff1
    style LAINNYA fill:#f5f5f5
